function(check_cli expected)
    execute_process(COMMAND ${USMAPGEN_EMULATOR} "${USMAPGEN}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "${ARGN}: expected exit ${expected}, got ${result}: ${output}${error}")
    endif()
    if(expected EQUAL 2 AND NOT error MATCHES "usage: usmapgen")
        message(FATAL_ERROR "${ARGN}: missing usage diagnostic")
    endif()
    if(expected EQUAL 1 AND NOT error MATCHES "cannot be opened")
        message(FATAL_ERROR "${ARGN}: option was not accepted before opening the input")
    endif()
endfunction()

#! A nonexistent child of the executable (a file) cannot be opened as an input.
set(missing "${USMAPGEN}/missing.exe")
set(output "${CMAKE_CURRENT_BINARY_DIR}/must-not-be-written.usmap")
check_cli(2)
check_cli(2 "${missing}")
check_cli(2 --name-casing)
check_cli(2 --name-casing non-preserving)
check_cli(2 --name-casing non-preserving "${missing}")
check_cli(2 --name-casing auto "${missing}" "${output}")
check_cli(2 --name-casing NonPreserving "${missing}" "${output}")
check_cli(2 --name-casing UNKNOWN "${missing}" "${output}")
check_cli(2 --other unknown "${missing}" "${output}")
check_cli(2 --name-casing=non-preserving "${missing}" "${output}")
check_cli(2 --name-casing unknown --name-casing preserving "${missing}" "${output}")
check_cli(2 "${missing}" "${output}" --name-casing unknown)
check_cli(2 "${missing}" "${output}" extra)
check_cli(1 "${missing}" "${output}")
foreach(mode unknown non-preserving preserving)
    check_cli(1 --name-casing "${mode}" "${missing}" "${output}")
endforeach()
if(EXISTS "${output}")
    message(FATAL_ERROR "Rejected commands created output")
endif()
message(STATUS "17 command-line checks passed")
